# Copiá este archivo como .env (cp .env.example .env) y dejá UNA de las dos líneas.
# El nombre de la base va al final de la URL: /centro-pokemon

# MongoDB en tu compu (127.0.0.1, no localhost)
MONGODB_URI=mongodb://127.0.0.1:27017/centro-pokemon

# MongoDB Atlas (reemplazá usuario, contraseña y cluster por los tuyos)
# MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/centro-pokemon

PORT=3000
